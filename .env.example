# ── Backend ────────────────────────────────────────────────────────────────
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# SQLite for zero-setup local runs. Compose overrides this with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./paperpal.db

# LLM: Groq via LangChain. Get a key at https://console.groq.com/keys
# Without a key PaperPal still runs (keyword routing + extractive answers).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# RAG: ChromaDB (embedded by default; set CHROMA_HOST to use a Chroma server)
CHROMA_DIR=./data/chroma
CHROMA_HOST=
CHROMA_PORT=8000

# Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=500

# Background processing (Compose enables Celery + Redis)
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# ── Auth ───────────────────────────────────────────────────────────────────
# Supabase: Project Settings → API. Enables email/password and Google sign-in.
SUPABASE_URL=
SUPABASE_JWT_SECRET=            # only needed for projects still using legacy HS256 JWTs

# Local demo account (no Supabase needed). Disable in any shared deployment.
DEMO_ENABLED=true
DEMO_EMAIL=demo@paperpal.dev
DEMO_PASSWORD=paperpal-demo
# Signs demo-session tokens. Change it outside local development.
AUTH_SECRET=paperpal-local-development-secret-change-me

# ── Frontend (read by Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
